# ===== 图片 API Key =====
PEXELS_API_KEY=your_pexels_api_key_here

# ===== Neo4j 图数据库 =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ===== Milvus 向量数据库 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== OneNET IoT 平台凭证 (必填) =====
ONENET_PRODUCT_ID=your_onenet_product_id
ONENET_DEVICE_NAME=device_01
ONENET_DEVICE_SECRET=your_onenet_device_secret
ONENET_ACCESS_KEY=your_onenet_access_key

# ===== LLM API Key (必填) =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== LLM 模型配置 =====
# 主 Agent 使用快速模型, RAG 生成使用 Pro 模型
LLM_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== Hugging Face 模型缓存 (离线加速启动) =====
# 使用默认缓存目录 ~/.cache/huggingface，不再使用项目内 .hf_cache
# 离线模式：仅用本地缓存，冷机首次下载时临时注释此行并配镜像
HF_HUB_OFFLINE=1
# 国内镜像（冷机首次下载时取消注释，与 HF_HUB_OFFLINE 二选一）
# HF_ENDPOINT=https://hf-mirror.com

# ===== API 认证 (生产环境必填，开发环境留空跳过) =====
API_KEY=your_api_key_here

# ===== CORS (生产环境设为实际域名) =====
CORS_ORIGINS=*

# ===== PostgreSQL 持久化 (Agent 记忆: 会话历史 + 用户偏好) =====
# 请自行设置强密码, 并保持 POSTGRES_URI 中的密码与 POSTGRES_PASSWORD 一致。
# 切勿将真实密码写入本文件 —— 本文件会随仓库公开发布。
POSTGRES_URI=postgresql://fridge:your_postgres_password_here@localhost:5432/fridge
POSTGRES_PASSWORD=your_postgres_password_here

# ===== Milvus 模式 (lite=嵌入式 / standalone=独立服务器) =====
MILVUS_MODE=standalone
MILVUS_LITE_PATH=./milvus_lite.db

# ===== LangSmith 可观测性 (可选) =====
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=fridgeai-backend
